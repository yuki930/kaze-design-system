{
  "name": "kaze-design-system",
  "version": "1.1.1",
  "private": false,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuki930/kaze-design-system.git"
  },
  "homepage": "https://github.com/yuki930/kaze-design-system",
  "bugs": {
    "url": "https://github.com/yuki930/kaze-design-system/issues"
  },
  "description": "Minimal React design system for dashboards, landing pages and Japanese UI: warm neutral grays, 78 components, SVG charts with zero dependencies, light/dark themes, typography tuned for CJK text",
  "keywords": [
    "design-system",
    "react",
    "css",
    "japanese",
    "zinc",
    "typography",
    "dark-mode",
    "components",
    "ui"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/types/components/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/components/index.d.ts",
      "import": "./dist/index.js"
    },
    "./marketing": {
      "types": "./dist/types/components/marketing.d.ts",
      "import": "./dist/marketing.js"
    },
    "./hooks": {
      "types": "./dist/types/hooks/index.d.ts",
      "import": "./dist/hooks.js"
    },
    "./tokens": {
      "types": "./dist/types/tokens/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./tokens/*.json": "./tokens/*.tokens.json",
    "./components/*": {
      "types": "./dist/types/components/*/index.d.ts",
      "import": "./dist/components/*/*.js"
    },
    "./package.json": "./package.json",
    "./css/tokens": "./tokens.css",
    "./css/reset": "./reset.css",
    "./css/components": "./components.css",
    "./css/utilities": "./utilities.css",
    "./css/all": "./kaze.css",
    "./css/core": "./core.css"
  },
  "files": [
    "dist",
    "tokens.css",
    "tokens",
    "reset.css",
    "components.css",
    "utilities.css",
    "kaze.css",
    "core.css",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "next dev --turbopack -p 4173",
    "prebuild": "node scripts/generate-llms.mjs && npm run storybook:site",
    "build": "next build",
    "docs:llms": "node scripts/generate-llms.mjs",
    "docs:check-usage": "node scripts/check-usage.mjs",
    "docs:stories": "node scripts/generate-stories.mjs",
    "size": "npm run build:lib && node scripts/measure-size.mjs",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:storybook": "vitest run --project storybook",
    "vrt:build": "storybook build -o storybook-static --quiet --disable-telemetry",
    "vrt": "playwright test -c vrt/playwright.config.ts",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "start": "next start",
    "build:lib": "rm -rf dist && vite build --config vite.config.lib.ts && tsc -p tsconfig.build.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:site": "storybook build -o public/storybook --quiet --disable-telemetry",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format .",
    "format:fix": "biome check --write .",
    "tokens": "node scripts/build-tokens.mjs"
  },
  "peerDependencies": {
    "lucide-react": "^0.575.0 || ^1.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@chromatic-com/storybook": "^5.0.1",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.2.10",
    "@storybook/addon-docs": "^10.2.10",
    "@storybook/addon-vitest": "^10.2.10",
    "@storybook/nextjs": "^10.2.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "26.6.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.61.0",
    "next": "^16.1.6",
    "playwright": "^1.58.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "storybook": "^10.2.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
